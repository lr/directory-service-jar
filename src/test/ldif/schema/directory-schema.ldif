dn: cn=schema
attributeTypes: ( someuEduEmpExpDate-oid NAME 'someuEduEmpExpDate' 
 EQUALITY generalizedTimeMatch ORDERING generalizedTimeOrderingMatch 
 SYNTAX 1.3.6.1.4.1.1466.115.121.1.24 SINGLE-VALUE 
 X-ORIGIN 'SomeU Edu Defined' )
attributeTypes: ( someuEduFacultyFlag-oid NAME 'someuEduFacultyFlag' 
 EQUALITY booleanMatch 
 SYNTAX 1.3.6.1.4.1.1466.115.121.1.7 SINGLE-VALUE 
 X-ORIGIN 'SomeU Edu Defined' )
objectClasses: ( someuEduPerson-oid 
 NAME 'someuEduPerson' 
 DESC 'SomeU Edu Person ObjectClass' 
 SUP inetorgPerson STRUCTURAL MUST uid MAY (
 someuEduEmpExpDate $ 
 someuEduFacultyFlag
 ) X-ORIGIN 'SomeU Edu Defined' )
attributeTypes: ( 1.3.6.1.4.1.61209.1.1.5 NAME 'ciChanges' DESC 'The change made to an entry, as an LDIF change record' EQUALITY octetStringMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.40 SINGLE-VALUE X-ORIGIN 'Canonical Identity defined' )
attributeTypes: ( 1.3.6.1.4.1.61209.1.1.6 NAME 'ciChangeSubject' DESC 'The ciID or DN of an entry affected by a change, such as its target or a member added to or removed from a group' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'Canonical Identity defined' )
attributeTypes: ( 1.3.6.1.4.1.61209.1.1.7 NAME 'ciChangeTarget' DESC 'The DN of the entry a change was made to, as it was at the time' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'Canonical Identity defined' )
attributeTypes: ( 1.3.6.1.4.1.61209.1.1.8 NAME 'ciChangeTime' DESC 'The time a change was made' EQUALITY generalizedTimeMatch ORDERING generalizedTimeOrderingMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.24 SINGLE-VALUE X-ORIGIN 'Canonical Identity defined' )
attributeTypes: ( 1.3.6.1.4.1.61209.1.1.9 NAME 'ciChangeType' DESC 'The type of a change: add, modify, delete or modrdn' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'Canonical Identity defined' )
attributeTypes: ( 1.3.6.1.4.1.61209.1.1.26 NAME 'ciID' DESC 'The unique Canonical Identity identifier for a person, group or other entity' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'Canonical Identity defined' )
attributeTypes: ( 1.3.6.1.4.1.61209.1.1.55 NAME 'ciModifiersName' DESC 'The name of the person/entity that last modified a record' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'Canonical Identity defined' )
attributeTypes: ( 1.3.6.1.4.1.61209.1.1.56 NAME 'ciModifyReason' DESC 'The reason a record was last modified' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'Canonical Identity defined' )
objectClasses: ( 1.3.6.1.4.1.61209.1.2.8 NAME 'ciChangeRecord' DESC 'A record of a change made to an entry' SUP top STRUCTURAL MUST ( cn $ ciChangeTarget $ ciChangeTime $ ciChangeType ) MAY ( ciChanges $ ciChangeSubject $ ciID $ ciModifiersName $ ciModifyReason ) X-ORIGIN 'Canonical Identity defined' )
attributeTypes: ( testRecordId-oid NAME 'testRecordId' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'Test change record schema' )
attributeTypes: ( testTarget-oid NAME 'testTarget' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'Test change record schema' )
attributeTypes: ( testWhen-oid NAME 'testWhen' EQUALITY generalizedTimeMatch ORDERING generalizedTimeOrderingMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.24 SINGLE-VALUE X-ORIGIN 'Test change record schema' )
attributeTypes: ( testKind-oid NAME 'testKind' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'Test change record schema' )
attributeTypes: ( testAffected-oid NAME 'testAffected' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'Test change record schema' )
attributeTypes: ( testDiff-oid NAME 'testDiff' EQUALITY octetStringMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.40 SINGLE-VALUE X-ORIGIN 'Test change record schema' )
objectClasses: ( testChangeEntry-oid NAME 'testChangeEntry' SUP top STRUCTURAL MUST ( testRecordId $ testTarget $ testWhen $ testKind ) MAY ( testAffected $ testDiff ) X-ORIGIN 'Test change record schema' )
